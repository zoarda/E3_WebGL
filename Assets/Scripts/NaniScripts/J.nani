# J-2
@streamingPlay "J-2"
@speedButtonEnable
@videoControll StartLoopTime:0 EndLoopTime:10 isLooping:false
@forcedChoice choiceTime:3
@waitMovie choiceTime:3
@EndMovie
@goto .J-2-Q

# J-2-Q
@streamingPlay "J-2-Q"
@speedButtonEnable
@videoControll StartLoopTime:0 EndLoopTime:10 isLooping:true
@forcedChoice choiceTime:3
@waitMovie choiceTime:3
@speedButtonDisable
@choiceDLC "PackId307" button:AvButton goto:.J-2-1
@choiceDLC "PackId303" button:AvButton goto:.J-2-2
@reBuildChoice
@stop

