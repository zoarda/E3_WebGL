# R-0
@streamingPlay "R-0"
@speedButtonEnable
@videoControll StartLoopTime:0 EndLoopTime:10 isLooping:true
@forcedChoice choiceTime:3
@waitMovie choiceTime:3
@speedButtonDisable
@choiceDLC "PackId304" button:AvButton goto:.R-0-1
@choiceDLC "PackId305" button:AvButton goto:.R-0-2
@choiceDLC "PackId306" button:AvButton goto:.R-0-3
@choiceDLC "PackId303" button:AvButton goto:.R-0-4
@reBuildChoice
@stop

# R-0-1
@streamingPlay "R-0-1"
@speedButtonEnable
@videoControll StartLoopTime:0 EndLoopTime:10 isLooping:false
@forcedChoice choiceTime:3
@waitMovie choiceTime:3
@EndMovie
@goto A.ActionPonitSetting

